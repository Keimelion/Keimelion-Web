# Base URL of the Keimelion API (Keimelion-API runs on 3000 in dev). Inlined into the client bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Public origin of this web app (3002 in dev; the BackOffice uses 3001). Used to build absolute URLs
# (share links, Open Graph metadata). Must match WEB_APP_URL in the API env, which builds the email links.
NEXT_PUBLIC_WEB_APP_URL=http://localhost:3002

# Notion integration token used by scripts/notion/notion.mjs (the Claude dev agent's Notion wrapper).
# Create an internal integration at https://www.notion.so/profile/integrations, then share the
# Keimelion backlog database with it. Not shipped to the client — read only by local Node scripts.
NOTION_TOKEN=
